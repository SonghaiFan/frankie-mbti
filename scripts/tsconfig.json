{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["graph/**/*.mts"],
  "exclude": ["../node_modules"]
}
