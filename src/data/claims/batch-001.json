      ]
    },
    {
      "id": "c009-04",
      "sourceIndex": 9,
      "kind": "behavior",
      "statement": "真正走近 INFP 后会发现他什么都说、藏不住心事，完全化成人形挂件、消息秒回；他话变少、看起来有心事时才是出了问题。",
      "subjects": [
        {
          "kind": "Type",
          "key": "INFP"
