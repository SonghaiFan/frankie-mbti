{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Typecheck and Lint",
			"type": "shell",
			"command": "npm run -s lint && npm run -s build",
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Build (prod)",
			"type": "shell",
			"command": "npm run -s build",
			"group": "build"
		},
		{
			"label": "Build (validate compact)",
			"type": "shell",
			"command": "npm run -s build",
			"group": "build"
		},
		{
			"label": "Build (compact top1 columns)",
			"type": "shell",
			"command": "npm run -s build",
			"group": "build"
		},
		{
			"label": "Rebuild (after TS fix)",
			"type": "shell",
			"command": "npm run -s build",
			"group": "build"
		}
	]
}